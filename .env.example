# Apache AGE graph database connection (see docker-compose.yml)
AGE_DB_HOST=localhost
AGE_DB_PORT=5433
AGE_DB_USER=graph_admin
AGE_DB_PASSWORD=changeme
AGE_DB_NAME=internal_control
AGE_DB_GRAPH_NAME=internal_control

# RDB: document/entity/relation SSOT (PostgreSQL 17.10, see docker-compose.yml)
RDB_DB_HOST=localhost
RDB_DB_PORT=5434
RDB_DB_USER=rdb_admin
RDB_DB_PASSWORD=changeme
RDB_DB_NAME=internal_control

# OpenSearch: entity/relation 인덱스 (description 임베딩)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# LLM used for document entity/relation extraction
# (project's existing vLLM server, OpenAI-compatible API)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=Qwen/Qwen3.6-27B
LLM_API_KEY=not-needed
